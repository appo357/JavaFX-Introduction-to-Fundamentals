<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="421.0" prefWidth="418.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="nz.ac.auckland.se206.controllers.CounterController">
   <children>
      <Pane prefHeight="494.0" prefWidth="513.0">
         <children>
            <Button fx:id="incrementButton" layoutX="28.0" layoutY="315.0" mnemonicParsing="false" onAction="#increment" prefHeight="22.0" prefWidth="77.0" text="Increment" />
            <Button fx:id="decrementButton" layoutX="170.0" layoutY="314.0" mnemonicParsing="false" onAction="#decrement" text="Decrement" />
            <Button fx:id="resetButton" layoutX="325.0" layoutY="316.0" mnemonicParsing="false" onAction="#reset" text="Reset" />
            <Label fx:id="numberLabel" alignment="CENTER" layoutX="177.0" layoutY="165.0" prefHeight="29.0" prefWidth="56.0" text="0" textAlignment="CENTER">
               <font>
                  <Font size="32.0" />
               </font>
            </Label>
            <Button fx:id="switchButton" layoutX="258.0" layoutY="19.0" mnemonicParsing="false" onAction="#switchToMusic" text="Switch to Music Player" />
         </children>
      </Pane>
   </children>
</StackPane>
